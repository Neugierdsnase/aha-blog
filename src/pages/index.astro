---
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
import GradientText from "../components/GradientText.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const blogPosts = (await getCollection("blog")).filter(
  ({ data }) => !data.draft,
);

const bookPosts = (await getCollection("book")).filter(
  ({ data }) => !data.draft,
);

const posts = [...blogPosts, ...bookPosts].sort((a, b) => {
  const relevantDateA = (a.data.pubDate ?? a.data.finishedDate).valueOf();
  const relevantDateB = (b.data.pubDate ?? b.data.finishedDate).valueOf();

  return relevantDateB - relevantDateA;
});
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} lang="de">
  <div
    id="hero"
    class="relative -inset-12 w-[200lvw] flex justify-center items-center overflow-clip h-[33svh]"
  >
    <!-- <h1 class="relative z-10 text-5xl"> -->
    <!-- <GradientText -->
    <!-- colors={["var(--color-foreground)", "var(--color-cherry-blossom-pink)"]} -->
    <!-- animationSpeed={8} -->
    <!-- showBorder={false} -->
    <!-- class="mx-0! max-w-none! rounded-none! p-0! backdrop-blur-none! cursor-default!" -->
    <!-- > -->
    <!-- Konstantin Kovar -->
    <!-- </GradientText> -->
    <!-- </h1> -->
  </div>

  <button class="btn btn-primary">Hi</button>

  <ul class="grid grid-cols-2 gap-4 mt-32">
    {
      posts.map(({ data }) => (
        <li>
          <Card title={data.title} subtitle={data.subtitle} />
        </li>
      ))
    }
  </ul>
</BaseLayout>

