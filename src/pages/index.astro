---
import { getCollection } from "astro:content";
import JustReadSection from "../components/JustReadSection.astro";
import JustWrittenSection from "../components/JustWrittenSection.astro";
import IntroductionSection from "../components/IntroductionSection.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} lang="de">
  <div
    id="hero"
    class="relative grid grid-cols-1 grid-rows-1 place-items-center w-full overflow-clip h-[44svh] bg-base-300"
  >
    <h1 class="z-10 text-5xl">Konstantin Kovar</h1>
    <div
      aria-hidden="true"
      class="hero-image absolute inset-x-0 bottom-0 top-[round(33%,28px)] z-0"
    >
    </div>
    <div
      class="hero-image-bottom absolute inset-x-0 bottom-0 h-7 z-20"
    >
    </div>
  </div>

  <div class="relative h-22 bg-base-100 z-20"></div>

<IntroductionSection />

<div class="flex flex-col gap-8 w-full items-center py-8">
<JustReadSection />

<JustWrittenSection />
</div>

</BaseLayout>

