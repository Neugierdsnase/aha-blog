---
import BackgroundQuotes from "../components/BackgroundQuotes.astro";
import GradientText from "../components/GradientText";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const backgroundQuotes = [
  {
    text: "Ihr nennt mich Menschenfeind, weil ich Gesellschaft meide. Ihr irrt euch, ich liebe sie. Doch um die Menschen nicht zu hassen, muss ich den Umgang unterlassen.",
    author: "Caspar David Friedrich",
  },
  {
    text: "Die Erde wird durch Liebe frei, durch Taten wird sie groß.",
    author: "Johann Wolfgang v. Goethe",
  },
  {
    text: "Was gibt uns den schönsten Frieden, als frei am eig'nen Glück zu schmieden?",
    author: "Johann Wolfgang v. Goethe",
  },
  {
    text: "Orden sind mir wurscht, aber haben will ich sie.",
    author: "Johannes Brahms",
  },
  {
    text: "Show me the incentive and I'll show you the outcome.",
    author: "Charles T. Munger",
  },
  {
    text: "… dass etwas schwer ist, muss uns ein Grund mehr sein, es zu tun.",
    author: "Rainer Maria Rilke",
  },
  {
    text: "Gesetze sind wie Würste, man sollte besser nicht dabei sein, wenn sie gemacht werden.",
    author: "Otto von Bismarck",
  },
  {
    text: "I did not have sexual relations with that woman.",
    author: "Bill Clinton",
  },
  {
    text: "Niemand hat die Absicht, eine Mauer zu errichten.",
    author: "Walter Ulbricht",
  },
  {
    text: "Da sind ein paar Hurenkinder dabei.",
    author: "Herbert Prohaska",
  },
  {
    text: "... there's some good in this world, Mr. Frodo, and it's worth fighting for.",
    author: "Samwise Gamgee",
  },
] as const;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} lang="de">
<div class="fixed inset-0 flex justify-center items-center overflow-clip">

<BackgroundQuotes quotes={backgroundQuotes} />

<h1 class="relative z-10 text-5xl">
  <GradientText
    client:load
    colors={["var(--color-foreground)", "var(--color-cherry-blossom-pink)"]}
    animationSpeed={8}
    showBorder={false}
    className="!mx-0 !max-w-none !rounded-none !p-0 !backdrop-blur-none !cursor-default"
  >
    Konstantin Kovar
  </GradientText>
</h1>

</div>
</BaseLayout>

