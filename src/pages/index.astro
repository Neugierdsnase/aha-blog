  @keyframes fadeInEven {
    0% {
      scale: 0.96;
      opacity: 0;
      transform: translate(-100px, 5px);
    }

    100% {
      scale: 1;
      opacity: 1;
      transform: translate(0px, 0px);
    }
  }

  @keyframes fadeIn {
    0% {
      scale: 0.96;
      opacity: 0;
      transform: translateY(5px);
    }

    100% {
      scale: 1;
      opacity: 1;
      transform: translateY(0px);
    }
  }

  li {
    animation: fadeIn backwards;
    animation-timeline: view();
    animation-range: entry;
  }
