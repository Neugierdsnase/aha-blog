  }

  @media not print and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      h1 {
        position: fixed;
        opacity: 0;
        animation: becomeInvisible backwards;
        animation-timeline: --nav-animationanchor, --nav-animationanchor;
        animation-range: exit;
      }
    }
