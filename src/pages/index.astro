---
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";

const blogPosts = (await getCollection("blog")).filter(
  ({ data }) => !data.draft,
);

const bookPosts = (await getCollection("book")).filter(
  ({ data }) => !data.draft,
);

const posts = [...blogPosts, ...bookPosts].sort((a, b) => {
  const relevantDateA = (a.data.pubDate ?? a.data.finishedDate).valueOf();
  const relevantDateB = (b.data.pubDate ?? b.data.finishedDate).valueOf();

  return relevantDateB - relevantDateA;
});
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} lang="de">
  <div
    id="hero"
    class="relative grid grid-cols-1 grid-rows-1 place-items-center w-full overflow-clip h-[33svh]"
  >
    <h1 class="relative z-10 text-5xl">Konstantin Kovar</h1>
  </div>

  <ul class="grid grid-cols-2 gap-4 mt-32">
    {
      posts.map(({ data }) => (
        <li>
          <Card title={data.title} subtitle={data.subtitle} />
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  #hero {
    background-color: var(--color-surface-high);
  }

  @keyframes fadeInEven {
    0% {
      scale: 0.96;
      opacity: 0;
      transform: translate(-100px, 5px);
    }

    100% {
      scale: 1;
      opacity: 1;
      transform: translate(0px, 0px);
    }
  }

  @keyframes fadeIn {
    0% {
      scale: 0.96;
      opacity: 0;
      transform: translateY(5px);
    }

    100% {
      scale: 1;
      opacity: 1;
      transform: translateY(0px);
    }
  }

  li {
    animation: fadeIn backwards;
    animation-timeline: view();
    animation-range: entry;
  }
</style>
