---
import BaseLayout from "../layouts/BaseLayout.astro";
import Article from "../components/Article.astro"
---

<BaseLayout
  title="Über den Konstantin"
  description="der eigentlich ganz ok ist."
  lang="de"
>
<Article>
  <div class="h-card about-page">
    <h1 class="p-name text-2xl">Konstantin</h1>

    <div class="p-note">
      <p>
        Softwareentwickler und Freizeitnostalgiker aus Wien.
      </p>
      <p>
        Über mich habe ich noch nichts geschrieben. Ist ja auch nicht notwendig.
      </p>
    </div>

    <div class="contact-info text-foreground-subtle">
      <a class="u-url u-uid" href="https://blog.vomkonstant.in/">https://blog.vomkonstant.in/</a>
    </div>
  </div>
  </Article>
</BaseLayout>
