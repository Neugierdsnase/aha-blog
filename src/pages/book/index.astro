---
import { getCollection } from "astro:content";
import BookListItem from "../../components/list-item/BookListItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const books = (await getCollection("book"))
  .filter(({ data }) => !data.draft && data.finishedDate)
  .sort(
    (a, b) => b.data.finishedDate!.valueOf() - a.data.finishedDate!.valueOf(),
  );
---

<BaseLayout
  lang="de"
  title="Jüngst gelesen"
  description="Die Bücher, die ich zuletzt gelesen habe."
>
  <div
    id="hero"
    class="relative grid grid-cols-1 grid-rows-1 place-items-center w-full overflow-clip h-[44svh] max-w-screen"
  >
    <h1 class="z-10 text-5xl">Jüngst gelesen</h1>
    <div id="hero-image" class="absolute inset-0 z-20 translate-y-12"></div>
  </div>
  <div class="relative w-full z-20 h-22 bg-base-100"></div>

  <ul class="p-4 desktop:p-0 grid grid-cols-1 gap-8">
    {books.map((book) => (
      <BookListItem {...book} />
    ))}
  </ul>
</BaseLayout>

<style>
  #hero-image {
    background: url("/img/bookshelf.svg") center bottom / contain no-repeat;
  }

  @media not print and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      h1 {
        position: fixed;
        opacity: 0;
        animation: becomeInvisible backwards;
        animation-timeline: --nav-animationanchor, --nav-animationanchor;
        animation-range: exit;
      }
    }
  }
</style>
