---
import { getCollection } from "astro:content";
import BookListItem from "../../components/list-item/BookListItem.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const books = (await getCollection("book"))
  .filter(({ data }) => !data.draft && data.finishedDate)
  .sort(
    (a, b) => b.data.finishedDate!.valueOf() - a.data.finishedDate!.valueOf(),
  );
---

<BaseLayout
  lang="de"
  title="Jüngst gelesen"
  description="Die Bücher, die ich zuletzt gelesen habe."
  ><div
    id="hero"
    class="relative grid grid-cols-1 grid-rows-1 place-items-center w-full overflow-clip h-[33svh]"
  >
    <h1 class="fixed z-10 col-start-1 row-start-1 text-5xl opacity-0">
      Jüngst gelesen
    </h1>
    <div id="hero-image" class="absolute inset-0 z-20"></div>
  </div>

  <ul class="p-4 desktop:p-0 grid grid-cols-1 gap-8 mt-22">
    {books.map((book) => <BookListItem {...book} />)}
  </ul>
</BaseLayout>

<style>
  @keyframes becomeInvisible {
    0% {
      opacity: 1;
    }
    24% {
      opacity: 1;
    }
    25% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  #hero-image {
    background: url("/img/books-hero.png") center / cover no-repeat;
    filter: sepia(80%);
  }

  h1 {
    animation: becomeInvisible backwards;
    animation-timeline: --nav-animationanchor, --nav-animationanchor;
    animation-range: exit;
  }
</style>
