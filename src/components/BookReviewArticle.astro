---
import type { CollectionEntry } from "astro:content";
import Article, { type ArticleLinkProps } from "./Article.astro";
import BookHeading from "./BookHeading.astro";

type Props = CollectionEntry<"book">["data"] & ArticleLinkProps;

const {
  title,
  subtitle,
  authors,
  releaseDate,
  finishedDate,
  author,
  url,
} = Astro.props;
---

<Article date={finishedDate} {author} {url}>
  <BookHeading slot="heading" {title} {subtitle} {authors} {releaseDate} />
  <slot />
</Article>
