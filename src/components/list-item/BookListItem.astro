---
import type { BookPost } from "../../types";
import { genreLabels } from "../../utils/genreLabels";
import { sanitizeViewTransitionName } from "../../utils/sanitizeViewTransitionName";

type Props = BookPost;

const { id, data } = Astro.props;
const {
  title,
  subtitle,
  authors,
  releaseDate,
  genre,
  rating,
  modeOfConsumption,
} = data;
const isAudiobook = modeOfConsumption === "audio";

const transitionName = sanitizeViewTransitionName(title);
const fullAuthors = authors.join(", ");
const authorsDisplay =
  fullAuthors.length > 20 && authors.length > 1
    ? `${authors[0]} et al.`
    : fullAuthors;
---

<li class="card list-none bg-base-200 @container">
<div class="p-4 pt-6">
      <h2 class="text-balance">
      <span
        class="font-display text-lg inline"
        style={`view-transition-name: --header-${transitionName};`}
      >
        {title}
        </span>
      {subtitle && (
        <span
          class="font-galnoy italic text-sm font-medium text-base-content block text-balance"
          style={`view-transition-name: --subheader-${transitionName};`}
        >
          {subtitle}
        </span>
      )}
      </h2>

      <div class="uppercase text-primary/70 my-4 tracking-widest">
        {genreLabels[genre.primary] ?? genre.primary.replace("-", " ")}
      </div>
      
      <span class="max-w-2/3 float-left">
      <span
        style={`view-transition-name: --author-${transitionName};`}
      >
        {authorsDisplay}
      </span>
      <span class="mx-1 text-secondary">󰣏</span>
      <span style={`view-transition-name: --release-date-${transitionName};`}>
        {releaseDate}
      </span>
      {rating != null && (
      <span class="mx-1 text-secondary">󰣏</span>
          <span class="font-datatype">{`{p:${rating * 10}}`}</span>
      )}
      {isAudiobook && (
        <span
          class="text-xxs text-base-primary/70 uppercase tracking-widest row-start-4 col-start-1 mt-1 self-end flex items-baseline gap-1"
          title="Hörbuch"
        >
          <span aria-hidden="true">󰋋</span>
          <span class="text-base-content/40">nur</span>
          <span>angehört</span>
        </span>
      )}
      </span>

  <a class="btn btn-sm btn-secondary float-right" href={"/book/" + id}>
  Notizen lesen
  </a>
</div>
</li>

