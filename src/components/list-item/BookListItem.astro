---
import type { BookPost } from "../../types";
import { genreLabels } from "../../utils/genreLabels";
import { sanitizeViewTransitionName } from "../../utils/sanitizeViewTransitionName";

type Props = BookPost;

const { id, data } = Astro.props;
const {
  title,
  subtitle,
  authors,
  releaseDate,
  genre,
  rating,
  modeOfConsumption,
} = data;
const isAudiobook = modeOfConsumption === "audio";

const transitionName = sanitizeViewTransitionName(title);
const fullAuthors = authors.join(", ");
const authorsDisplay =
  fullAuthors.length > 20 && authors.length > 1
    ? `${authors[0]} et al.`
    : fullAuthors;
---

<li class="card list-none bg-base-200">
  <a href={"/book/" + id}>
    <div class="card-title">
      <p
        class="font-display text-lg line-clamp-1"
        style={`view-transition-name: --header-${transitionName};`}
      >
        {title}
      </p>
      {
        subtitle && (
          <p
            class="font-galnoy italic text-sm text-base-content line-clamp-1"
            style={`view-transition-name: --subheader-${transitionName};`}
          >
            {subtitle}
          </p>
        )
      }
    </div>

    <div class="card-content text-xs overflow-hidden">
      <span
        class="font-serif"
        style={`view-transition-name: --author-${transitionName};`}
        >{authorsDisplay}</span
      >
      <span class="text-surface-high text-[0.5em]" aria-hidden="true"
        >&#xf0b8a;</span
      >
      <span style={`view-transition-name: --release-date-${transitionName};`}
        >{releaseDate}</span
      >
      {
        rating != null && (
          <>
            <span class="text-surface-high text-[0.5em]" aria-hidden="true">
              &#xf0b8a;
            </span>
            <span class="font-old tabular-nums">{rating}/10</span>
          </>
        )
      }
      {
        isAudiobook && (
          <span
            class="text-xxs text-base-content/70 uppercase tracking-widest row-start-4 col-start-1 mt-1 self-end flex items-baseline gap-1"
            title="Hörbuch"
          >
            <span aria-hidden="true">󰋋</span>
            <span class="text-base-content/40 ">nur</span>
            <span>angehört</span>
          </span>
        )
      }
      <span class="genre"
        >{genreLabels[genre.primary] ?? genre.primary.replace("-", " ")}</span
      >
    </div>
  </a>
</li>

<style>
  @reference "../../styles/app.css";

  .smallcaps {
    font-variant: small-caps;
  }

  .genre {
    @apply text-xxs text-base-content/70 uppercase tracking-widest
      row-start-4 col-start-2 mt-1 self-end text-right;
    font-variant: small-caps;
  }
</style>
