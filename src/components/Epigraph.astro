---
interface Props {
  quote: string;
  footer: string;
}

const { quote, footer } = Astro.props;
---

<div class="epigraph">
  <blockquote style="border-left: none;">
    <p set:html={quote} />
    <footer set:html={footer} />
  </blockquote>
</div>

<style>
  .epigraph {
    margin: 5em 0;
  }

  .epigraph > blockquote {
    margin: 3em 0;
  }

  .epigraph > blockquote,
  .epigraph > blockquote > p {
    font-style: italic;
  }

  .epigraph > blockquote > footer {
    font-style: normal;
  }

  .epigraph > blockquote > footer :global(cite) {
    font-style: italic;
  }
</style>
