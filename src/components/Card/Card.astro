---
import CornerSVG from "./CornerSVG.astro";
import CardFront from "./CardFront.astro";
import CardBack from "./CardBack.astro";
---

<div ontouchstart="this.classList.toggle('hover');">
  <div class="container">
    <div class="front">
      <CardFront>
        <slot name="front" />
      </CardFront>
    </div>
    <div class="back">
      <CardBack>
        <slot name="back" />
      </CardBack>
    </div>
  </div>
</div>

<style>
  path {
    fill: var(--color-base-content);
  }
  .container {
    transform-style: preserve-3d;
    perspective: 1000px;
  }

  .front,
  .back {
    border-radius: 10px;
    background-position: center;
    transition: transform 0.7s;
    transition-timing-function: ease-in-out;
    backface-visibility: hidden;
    text-align: center;
    min-height: 180px;
    height: auto;
    border-radius: 10px;
    color: var(--color-base-content);
    font-size: 1.5rem;
  }

  .back {
    background: linear-gradient(
      45deg,
      var(--color-base-100),
      var(--color-base-100)
    );
  }

  .front:after {
    position: absolute;
    background-repeat: no-repeat;
    top: 0;
    left: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    content: "";
    display: block;
    background-color: var(--color-base-100);
    backface-visibility: hidden;
    border-radius: 10px;
  }
  .container:hover .front,
  .container:hover .back {
    transition: transform 0.7s;
  }

  .back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
  }

  .container .back {
    transform: rotateY(180deg);
    transform-style: preserve-3d;
  }

  .container .front {
    transform: rotateY(0deg);
    transform-style: preserve-3d;
  }

  .container:hover .back {
    transform: rotateY(0deg);
    transform-style: preserve-3d;
  }

  .container:hover .front {
    transform: rotateY(-180deg);
    transform-style: preserve-3d;
  }

  .front .inner p {
    font-size: 2rem;
    margin-bottom: 2rem;
    position: relative;
  }
</style>
