---
import CornerSVG from "./CornerSVG.astro";
---

<div class="inner top-1/2 flex justify-center items-center absolute left-0 size-full border-box outline outline-base-content perspective-inherit z-2">
  <div class="absolute top-1 left-1 size-22">
    <CornerSVG />
  </div>

  <div class="absolute top-1 right-1 size-22 rotate-y-180">
    <CornerSVG />
  </div>

  <div class="absolute bottom-1 left-1 size-22 rotate-x-180">
    <CornerSVG />
  </div>

  <div class="absolute bottom-1 right-1 size-22 rotate-y-180 rotate-x-180">
    <CornerSVG />
  </div>
  <slot />
</div>

<style>
  .inner {
    transform: translateY(-50%) translateZ(60px) scale(0.94);
  }
</style>
