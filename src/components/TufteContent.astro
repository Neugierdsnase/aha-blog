---
/**
 * Wrapper component that transforms rendered markdown into Tufte web
 * components (footnotes → sidenotes/margin notes, and block elements →
 * `<tufte-*>`). The transformation itself lives in a pure, unit-tested module.
 *
 * Usage:
 *   <TufteContent>
 *     <Content />
 *   </TufteContent>
 */
import { transformTufteContent } from "../lib/tufte-content/transform";

const html = await Astro.slots.render("default");
const transformedHtml = transformTufteContent(html);
---

<Fragment set:html={transformedHtml} />
