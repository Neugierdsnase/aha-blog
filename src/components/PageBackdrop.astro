<div class="page-backdrop" aria-hidden="true"></div>

<style is:global>
  @reference "../styles/app.css";

  /* Fixed, full-viewport gradient + film grain behind all content, so glass
     surfaces like .glass-nav have something visible to blur. */
  .page-backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    /* Fallback for browsers without gradient-color-space support: plain
       sRGB interpolation between the same stops. */
    background-image: linear-gradient(
      177deg,
      var(--color-cherry-blossom-pink),
      color-mix(
          in oklch,
          var(--color-background) 82%,
          var(--color-black-bean) 18%
        )
        320lvh
    );
    /* Enhanced: interpolate through OKLCH so the pink/peach accents travel
       to transparent (and the base tint darkens) without washing out gray
       in between — see joshwcomeau.com/css/make-beautiful-gradients.
       Stops use `lvh` (not `%`) so the colored wash stays a fixed height
       near the top of the page — `.page-backdrop` now spans the full
       document (see body's `position: relative` in app.css) rather than
       a capped 200lvh, so `%` stops would stretch across arbitrarily
       long pages and never fully settle into the flat background. */
    background-image: linear-gradient(
      177deg in oklch,
      color-mix(
        in oklch,
        var(--color-cherry-blossom-pink) 32%,
        var(--color-background)
      ),
      color-mix(
          in oklch,
          var(--color-cherry-blossom-pink) 22%,
          var(--color-surface)
        )
        44lvh,
      color-mix(
          in oklch,
          var(--color-cherry-blossom-pink) 12%,
          var(--color-background)
        )
        72lvh,
      color-mix(
        in oklch,
        var(--color-cherry-blossom-pink) 8%,
        var(--color-background)
      ),
      color-mix(
          in oklch,
          var(--color-cherry-blossom-pink) 4%,
          var(--color-background)
        )
        92lvh,
      var(--color-background) 118lvh
    );
  }

  /* Grain per css-tricks.com/grainy-gradients: raw SVG turbulence, pushed
     from a smooth colorful cloud into stark black/white speckle via a
     contrast + brightness boost, then blended over the gradient. */
  .page-backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.55;
    mix-blend-mode: overlay;
    filter: contrast(200%) brightness(1300%);
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%20200%20200'%3E%3Cfilter%20id%3D'noiseFilter'%3E%3CfeTurbulence%20type%3D'fractalNoise'%20baseFrequency%3D'0.65'%20numOctaves%3D'3'%20stitchTiles%3D'stitch'%2F%3E%3C%2Ffilter%3E%3Crect%20width%3D'100%25'%20height%3D'100%25'%20filter%3D'url(%23noiseFilter)'%2F%3E%3C%2Fsvg%3E");
    background-size: 180px 180px;
  }

  @media print {
    /* No ink for the ambient gradient/grain layer */
    .page-backdrop {
      display: none !important;
    }
  }
</style>
