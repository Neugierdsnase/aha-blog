---
import { sanitizeViewTransitionName } from "../utils/sanitizeViewTransitionName";

interface Props {
  title: string;
  subtitle?: string;
  authors?: string[];
  releaseDate?: number | string;
}

const { title, subtitle, authors, releaseDate } = Astro.props;
const transitionName = sanitizeViewTransitionName(title);

const names = authors?.map((a) => a.trim()) ?? [];
const authorsText =
  names.length > 1
    ? `${names.slice(0, -1).join(", ")} und ${names.at(-1)}`
    : (names[0] ?? "");
const authorsLine = [authorsText, releaseDate].filter(Boolean).join(", ");
---

<div class="book-heading">
  <tufte-h1
    class="text-pretty p-name"
    style=`view-transition-name: --header-${transitionName};`
    data-testid="heading-book"
  >
    {title}
  </tufte-h1>
  {subtitle && <tufte-subtitle style=`view-transition-name: --subheader-${transitionName};`>{subtitle}</tufte-subtitle>}
  {authorsLine && <div class="authors" style=`view-transition-name: --author-${transitionName};` set:html={authorsLine} />}
</div>

<style>
  h1 {
    font-weight: 400;
    margin-top: 4rem;
    margin-bottom: min(2.5cqw, 1rem);
    font-size: 3.2rem;
    line-height: 1;
  }

  .subtitle {
    font-style: italic;
    font-size: 1.8rem;
    display: block;
    line-height: 1;
    &:before {
      display: none;
    }
  }

  .book-heading {
    margin-bottom: min(10cqw, 4rem);
  }

  div.authors {
    display: inline;
    margin-top: calc(var(--heading-margin-bottom) * -1.01);
    margin-bottom: calc(var(--heading-margin-bottom) - 1ch);
    padding: 0px;
    color: var(--color-foreground-subtle);
    font-size: 1.1rem;
  }
</style>
