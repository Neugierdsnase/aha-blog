---
import FormattedDate from "./FormattedDate.astro";

interface Props {
  author?: string;
  pubDate?: Date;
  updatedDate?: Date;
  url?: string;
}

const { author, pubDate, updatedDate, url } = Astro.props;
---

<!-- Microformat metadata -->
<div class="article-meta meta-row">
  {
    author && (
      <span class="p-author h-card">
        <a class="p-name u-url" href="/">
          {author}
        </a>
      </span>
    )
  }
  {
    pubDate && (
      <time class="dt-published" datetime={pubDate.toISOString()}>
        <FormattedDate date={pubDate} />
      </time>
    )
  }
  {
    updatedDate && (
      <time class="dt-updated" datetime={updatedDate.toISOString()}>
        (updated: <FormattedDate date={updatedDate} />)
      </time>
    )
  }
  {
    url && (
      <a class="u-url" href={url} style="display:none;">
        {url}
      </a>
    )
  }
</div>

<style>
  .article-meta time,
  .article-meta .p-author {
    display: inline;
  }

  .article-meta .p-author a {
    text-decoration: none;
  }
</style>
