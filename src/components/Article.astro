---
import type { CollectionEntry } from "astro:content";
import ArticleMeta from "./ArticleMeta.astro";
import BookHeading from "./BookHeading.astro";
import SyndicationLinks from "./SyndicationLinks.astro";
import Webmentions from "./Webmentions";
import Sidenotes from "./Sidenotes.astro";
import "../styles/tufte-prose.css";

type Props = Partial<CollectionEntry<"book" | "blog">["data"]> & {
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  url?: string;
  syndication?: Array<{ name: string; url: string }>;
};

const {
  pubDate,
  updatedDate,
  author = "Konstantin",
  url,
  syndication,
} = Astro.props;
---

<div class="container" data-testid="article-container">
  <article class="h-entry">
    <section>
      {
        Astro.props.title && (
          <BookHeading {...Astro.props} title={Astro.props.title} />
        )
      }

      <ArticleMeta {author} {pubDate} {updatedDate} {url} />

      <SyndicationLinks {syndication} />

      <div class="e-content" style="view-transition-name: --article-content;">
        <slot />
      </div>

      <Sidenotes />

      {url && <Webmentions url={url} client:load />}
    </section>
  </article>
</div>

<style is:global>
  /* The [data-sidenotes] attribute is set by Sidenotes.astro when footnotes
     exist; it switches the two-column layout to the wide-margin Tufte layout */
  .container {
    container-type: inline-size;
    &:not([data-sidenotes]) {
      margin: 0 auto 2em;
    }
    &[data-sidenotes] {
      max-width: 900px;
    }

    /* Tufte CSS styles */
    article {
      display: block;
      width: 100%;
      margin: auto;
      padding: 0;
      color: var(--color-foreground, #111);
      max-width: 1400px;
      counter-reset: sidenote-counter;
    }

    &:not([data-sidenotes]) article {
      section {
        columns: 2 35ch;
        column-gap: 3rem;

        & > * {
          max-width: 69ch;
        }

        & > .book-heading {
          column-span: all;
        }
      }
    }

    @container (max-width: 1240px) {
      article {
        width: 90%;
        padding: 1svw 3svw;
      }
    }

    @container (max-width: 760px) {
      article {
        width: 94%;
        margin: 0 1vw;
        padding-right: 0;
      }
    }
  }
</style>
