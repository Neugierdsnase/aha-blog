---
import ArticleMeta from "./ArticleMeta.astro";
import FormattedDate from "./FormattedDate.astro";
import SyndicationLinks from "./SyndicationLinks.astro";
import Webmentions from "./Webmentions";

export type ArticleLinkProps = {
  author?: string;
  url?: string;
};

interface Props extends ArticleLinkProps {
  date?: Date;
  updatedDate?: Date;
  syndication?: Array<{ name: string; url: string }>;
}

const {
  date,
  updatedDate,
  author = "Konstantin",
  url,
  syndication,
} = Astro.props;
---

<tufte-article data-testid="article-container" class="h-entry">
    <section>
      <slot name="heading" />

      <ArticleMeta {updatedDate} {url} />

      <SyndicationLinks {syndication} />

      <div class="e-content" style="view-transition-name: --article-content;">
        <slot />
      </div>

      {
        (author || date) && (
          <p class="text-foreground-subtle">
            {
              author && (
                <span class="p-author h-card">
                  <a class="p-name u-url" href="/">
                    {author}
                  </a>
                </span>
              )
            }
            {
              date && (
                <time class="dt-published" datetime={date.toISOString()}>
                  {', '}<FormattedDate date={date} />
                </time>
              )
            }
          </p>
        )
      }

      {url && <Webmentions url={url} client:idle />}
    </section>
</tufte-article>

<style>
  .article-byline .p-author a {
    text-decoration: none;
  }

  .article-byline .p-author + time::before {
    content: ", ";
  }
</style>

<script>
  // Register the Tufte web components (inlined at src/lib/tufte-components)
  import "../lib/tufte-components";
</script>
