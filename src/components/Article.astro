---
import type { CollectionEntry } from "astro:content";
import ArticleMeta from "./ArticleMeta.astro";
import BookHeading from "./BookHeading.astro";
import FormattedDate from "./FormattedDate.astro";
import PostHeading from "./PostHeading.astro";
import SyndicationLinks from "./SyndicationLinks.astro";
import Webmentions from "./Webmentions";

type Props = Partial<CollectionEntry<"book" | "blog">["data"]> & {
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  url?: string;
  syndication?: Array<{ name: string; url: string }>;
};

const {
  pubDate,
  updatedDate,
  author = "Konstantin",
  url,
  syndication,
} = Astro.props;

// Book reviews carry authors; blog posts (and everything else) don't.
const isBook = "authors" in Astro.props;
---

<tufte-article data-testid="article-container" class="h-entry">
    <section>
      {
        Astro.props.title &&
          (isBook ? (
            <BookHeading {...Astro.props} title={Astro.props.title} />
          ) : (
            <PostHeading {...Astro.props} title={Astro.props.title} />
          ))
      }

      <ArticleMeta {updatedDate} {url} />

      <SyndicationLinks {syndication} />

      <div class="e-content" style="view-transition-name: --article-content;">
        <slot />
      </div>

      {url && <Webmentions url={url} client:idle />}

      {
        (author || pubDate) && (
          <p class="article-byline">
            {
              author && (
                <span class="p-author h-card">
                  <a class="p-name u-url" href="/">
                    {author}
                  </a>
                </span>
              )
            }
            {
              pubDate && (
                <time class="dt-published" datetime={pubDate.toISOString()}>
                  <FormattedDate date={pubDate} />
                </time>
              )
            }
          </p>
        )
      }
    </section>
</tufte-article>

<style>
  .article-byline {
    color: var(--color-foreground-subtle);
  }

  .article-byline .p-author a {
    text-decoration: none;
  }

  .article-byline .p-author + time::before {
    content: ", ";
  }
</style>

<script>
  // Register the Tufte web components (inlined at src/lib/tufte-components)
  import "../lib/tufte-components";
</script>
