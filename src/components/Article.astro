---
import type { CollectionEntry } from "astro:content";
import ArticleMeta from "./ArticleMeta.astro";
import BookHeading from "./BookHeading.astro";
import SyndicationLinks from "./SyndicationLinks.astro";
import Webmentions from "./Webmentions";
import Sidenotes from "./Sidenotes.astro";
import "../styles/tufte-prose.css";

type Props = Partial<CollectionEntry<"book" | "blog">["data"]> & {
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  url?: string;
  syndication?: Array<{ name: string; url: string }>;
};

const {
  pubDate,
  updatedDate,
  author = "Konstantin",
  url,
  syndication,
} = Astro.props;
---

<div class="container" data-testid="article-container">
  <article class="h-entry">
    <section>
      {
        Astro.props.title && (
          <BookHeading {...Astro.props} title={Astro.props.title} />
        )
      }

      <ArticleMeta {author} {pubDate} {updatedDate} {url} />

      <SyndicationLinks {syndication} />

      <div class="e-content" style="view-transition-name: --article-content;">
        <slot />
      </div>

      <Sidenotes />

      {url && <Webmentions url={url} client:load />}
    </section>
  </article>
</div>

<style is:global>
  .container {
    container-type: inline-size;
    &:not(:has(.margin-toggle)) {
      contain: width;
      margin: 0 auto 2em;
    }
    &:has(.margin-toggle) {
      max-width: 900px;
    }

    /* Tufte CSS styles */
    @container (min-width: 0px) {
      article {
        display: block;
        width: 100%;
        &:not(:has(.margin-toggle)) {
          margin: auto;
          padding-left: 0;
        }
        padding: 2rem 0;
        color: var(--color-foreground, #111);
        max-width: 1400px;
        counter-reset: sidenote-counter;

        section > p,
        section > footer,
        section > table {
          width: 100%;
        }

        &:not(:has(.margin-toggle)) section {
          columns: 2 35ch;
          column-gap: 3rem;

          & > * {
            max-width: 69ch;
          }

          & > .book-heading {
            column-span: all;
          }
        }

        &:has(.margin-toggle) section > p,
        &:has(.margin-toggle) section > footer,
        &:has(.margin-toggle) section > table {
          max-width: 69ch;
        }

        &:has(.margin-toggle) {
          section > p,
          section > footer,
          section > table {
            width: 75%;
          }
        }

        /* 50 + 5 == 55, to be the same width as paragraph */
        section > dl,
        section > ol,
        section > ul {
          width: 70%;
          -webkit-padding-start: 5%;
        }
      }
    }

    @container (max-width: 1240px) {
      article {
        width: 90%;
        padding: 1svw 3svw;
      }
    }

    @container (max-width: 760px) {
      article {
        width: 94%;
        margin: 0 1vw;
        padding-right: 0;
        section > p,
        section > footer,
        section > table {
          width: 100%;
        }
        &:has(.margin-toggle) {
          section > p,
          section > footer,
          section > table {
            width: 100%;
          }
        }

        section > dl,
        section > ol,
        section > ul {
          width: 90%;
        }
      }
    }
  }
</style>
