---
import type { CollectionEntry } from "astro:content";
import ArticleMeta from "./ArticleMeta.astro";
import BookHeading from "./BookHeading.astro";
import SyndicationLinks from "./SyndicationLinks.astro";
import Webmentions from "./Webmentions";
import "../styles/tufte-prose.css";

type Props = Partial<CollectionEntry<"book" | "blog">["data"]> & {
  pubDate?: Date;
  updatedDate?: Date;
  author?: string;
  url?: string;
  syndication?: Array<{ name: string; url: string }>;
};

const {
  pubDate,
  updatedDate,
  author = "Konstantin",
  url,
  syndication,
} = Astro.props;
---

<tufte-article data-testid="article-container">
  <article class="h-entry">
    <section>
      {
        Astro.props.title && (
          <BookHeading {...Astro.props} title={Astro.props.title} />
        )
      }

      <ArticleMeta {author} {pubDate} {updatedDate} {url} />

      <SyndicationLinks {syndication} />

      <div class="e-content" style="view-transition-name: --article-content;">
        <slot />
      </div>

      {url && <Webmentions url={url} client:load />}
    </section>
  </article>
</tufte-article>

<style is:global>
  /* Hide components until defined to prevent FOUC */
  tufte-article:not(:defined),
  tufte-sidenote:not(:defined),
  tufte-marginnote:not(:defined),
  tufte-epigraph:not(:defined),
  tufte-figure:not(:defined),
  tufte-newthought:not(:defined) {
    visibility: hidden;
  }
</style>

<script>
  import "tufte-css";
</script>
