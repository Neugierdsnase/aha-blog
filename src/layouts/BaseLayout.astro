---
import BaseHead from "../components/BaseHead.astro";
import { GOATCOUNTER_URL, NAV_PAGES } from "../consts";
import { HomeLink } from "../components/HomeLink.tsx";
import NavMenu from "../components/NavMenu.astro";

type Props = {
  lang: "de" | "en";
  title: string;
  description?: string;
  type?: "website" | "article" | "book";
  pubDate?: Date;
  updatedDate?: Date;
  image?: string;
  author?: string;
};

const { lang, title, description, type, pubDate, updatedDate, image, author } =
  Astro.props;
const isIndex = Astro.url.pathname === "/";
---

<html lang={lang} class="dark">
  <BaseHead
    title={title + " vom Konstantin"}
    description={description}
    type={type}
    pubDate={pubDate}
    updatedDate={updatedDate}
    image={image}
    author={author}
    lang={lang}
  />
  <body>
    <div id="nav-animation-anchor" class="absolute h-[50svh]"></div>
    <nav
      id="main-nav"
      class="fixed inset-x-8 rounded top-0 z-1001 bg-base-100 flex items-center px-8 py-1"
      style="view-transition-name: --nav;"
      aria-label="Main navigation"
    >
      {!isIndex && <HomeLink />}
      <div class="ml-auto">
        <NavMenu items={NAV_PAGES} menuAriaLabel="Toggle navigation" />
      </div>
    </nav>

    <div
      id="body"
      class="max-w-full p-2 desktop:p-8 w-full desktop:flex desktop:gap-12"
    >
      <main class="min-w-0 flex-1">
        <slot />
      </main>
    </div>

    <script
      is:inline
      data-goatcounter={GOATCOUNTER_URL}
      async
      src="//gc.zgo.at/count.js"></script>
  </body>
</html>

<style>
  body {
    timeline-scope: --nav-animationanchor;
  }

  #nav-animation-anchor {
    view-timeline: --nav-animationanchor;
  }

  #body {
    overflow-x: hidden;
  }

  @keyframes stickToTop {
    0% {
      border-radius: 4px;
      top: 2rem;
      left: 2rem;
      right: 2rem;
    }

    100% {
      border-radius: 0px;
      transform: translateY(0rem);
      top: 0rem;
      left: 0rem;
      right: 0rem;
    }
  }

  @keyframes becomeOpaque {
    0% {
      background: color-mix(var(--color-base-100) 0%, rgba(0, 0, 0, 0) 100%);
    }

    65% {
      background: color-mix(var(--color-base-100) 0%, rgba(0, 0, 0, 0) 100%);
    }

    69% {
      background: color-mix(var(--color-base-100) 100%, rgba(0, 0, 0, 1) 0%);
    }
  }

  #main-nav {
    animation:
      stickToTop forwards,
      becomeOpaque forwards;
    animation-timeline: --nav-animationanchor, --nav-animationanchor;
    animation-range: exit, exit;
  }
</style>
