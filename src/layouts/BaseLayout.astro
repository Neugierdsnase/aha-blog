---
import BaseHead from "../components/BaseHead.astro";
import { GOATCOUNTER_URL, NAV_PAGES } from "../consts";
import { HomeLink } from "@/components/HomeLink.tsx";
import { NavMenu } from "@/components/NavMenu.tsx";
import PageBackdrop from "../components/PageBackdrop.astro";

type Props = {
  lang: "de" | "en";
  title: string;
  description?: string;
  type?: "website" | "article" | "book";
  pubDate?: Date;
  updatedDate?: Date;
  image?: string;
  author?: string;
};

const { lang, title, description, type, pubDate, updatedDate, image, author } =
  Astro.props;
const isIndex = Astro.url.pathname === "/";
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme");
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };
  const isDark = getThemePreference() === "dark";
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark");
      localStorage.setItem("theme", isDark ? "dark" : "light");
    });
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }
</script>

<html lang={lang}>
  <BaseHead
    title={title + " vom Konstantin"}
    description={description}
    type={type}
    pubDate={pubDate}
    updatedDate={updatedDate}
    image={image}
    author={author}
    lang={lang}
  />
  <body>
    <PageBackdrop />
    <nav
      class="glass-nav fixed inset-x-0 top-8 z-[1001] flex items-center px-8 py-1"
      style="view-transition-name: --nav;"
      aria-label="Main navigation"
    >
      {!isIndex && <HomeLink />}
      <div class="ml-auto">
        <NavMenu client:load items={NAV_PAGES} menuAriaLabel="Toggle navigation" />
      </div>
    </nav>

    <!-- Matches the fixed nav's own height (top-8 offset + button row +
         vertical margin) so page content starts clear of it instead of
         sliding underneath. -->
    <div class="h-18" aria-hidden="true"></div>

    <div
      id="body"
      class="max-w-full p-2 desktop:p-8 w-full desktop:flex desktop:gap-12"
    >
      <main class="min-w-0 flex-1">
        <slot />
      </main>
    </div>

    <script
      is:inline
      data-goatcounter={GOATCOUNTER_URL}
      async
      src="//gc.zgo.at/count.js"></script>
  </body>
</html>
