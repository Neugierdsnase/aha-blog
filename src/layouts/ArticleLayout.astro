---
import type { CollectionEntry } from "astro:content";
import Article from "../components/Article.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

type Props = CollectionEntry<"book" | "blog">["data"] & { lang?: "de" | "en" };

const props = Astro.props;
const { title, description, lang = "de" } = props;

// Blog posts carry pubDate; book reviews carry finishedDate. Narrow on that.
const isBlog = "pubDate" in props;
const contentType = isBlog ? "article" : "book";

const pubDate = isBlog ? props.pubDate : props.finishedDate;
const updatedDate = isBlog ? props.updatedDate : undefined;
const heroImage = isBlog ? props.heroImage : undefined;

// Get canonical URL for h-entry
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  type={contentType}
  pubDate={pubDate}
  updatedDate={updatedDate}
  image={heroImage}
>
  <Article
    {...Astro.props}
    pubDate={pubDate}
    updatedDate={updatedDate}
    url={canonicalURL.toString()}
  >
    <slot />
  </Article>
</BaseLayout>
